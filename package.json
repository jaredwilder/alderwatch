{
  "name": "alderwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:animals": "node scripts/fetch_animals.mjs",
    "assets:medieval": "node scripts/fetch_medieval.mjs",
    "assets:characters": "node scripts/fetch_characters.mjs",
    "predev": "npm run assets:animals && npm run assets:medieval && npm run assets:characters",
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "prebuild": "npm run assets:animals && npm run assets:medieval && npm run assets:characters",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5191 --strictPort",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {"three": "^0.185.1", "@dimforge/rapier3d-compat": "^0.19.0"},
  "devDependencies": {"@types/three": "^0.185.0", "typescript": "^5.9.2", "vite": "^8.2.0", "tsx": "^4.21.0", "@gltf-transform/cli": "^4.3.0"}
}
